# ---------------------------------------------------------------------------
# WebDAV test server: never commit TLS private keys / serial files / local DB
# Even though these are self-signed test certs, private keys must stay local.
# The wsgidav.yaml hardcoded credentials below are binded to 127.0.0.1 only.
scripts/webdav_test/*.key
scripts/webdav_test/*.srl
scripts/webdav_test/*.csr
scripts/webdav_test/data/

# live_db roundtrip test fixtures contain real-looking ledger dumps
scripts/live_db/
